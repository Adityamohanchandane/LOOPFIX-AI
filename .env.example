# LoopFix AI - Environment Variables
# Copy this file to .env and add your local credentials. Do not commit .env.

# Optional Groq API key for AI-powered complaint analysis
GROQ_API_KEY=your_groq_api_key

# Optional Gemini backup key, used when Groq is unavailable or fails
GEMINI_API_KEY=your_gemini_api_key

# Firebase Admin credentials for persistent Firestore storage
FIREBASE_PROJECT_ID=your_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=.secrets/firebase-service-account.json

# Server
PORT=3001
NODE_ENV=development
